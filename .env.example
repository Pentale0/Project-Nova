# --- PROJECT NOVA environment ---
# Copy this file to .env and fill in real values. .env is gitignored; never
# commit real keys.
#
# Two providers are supported. OpenRouter wins when its key is present;
# otherwise the server falls back to Google Gemini.
#
# LOCAL DEV: a .env in the project root is read automatically by the Express
# dev server (server/index.ts).
#
# VERCEL: .env is NOT read on Vercel. The key must also be added in the
# dashboard under Project > Settings > Environment Variables, marked for
# Production and Preview. Without it, /api/health reports aiConfigured:false
# and the three AI routes return 503.

# --- Provider 1: OpenRouter (primary) ---
# Key from https://openrouter.ai/keys
# Used ONLY by the server (server/index.ts) — never sent to the browser.
OPENROUTER_API_KEY=

# Model id from https://openrouter.ai/models
OPENROUTER_MODEL=inclusionai/ling-3.0-flash

# Optional: attribution headers, shown on your OpenRouter dashboard.
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_TITLE=Project Nova

# --- Provider 2: Google Gemini (fallback) ---
# Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Point at a gateway/proxy that fronts the Gemini API:
# GEMINI_BASE_URL=https://my-gateway.example.com

# --- Shared ---
# How many times to retry a temporary capacity/rate error. Default 3
# (roughly 1s, 2s, 4s of backoff).
# AI_MAX_RETRIES=3

# --- Port (local dev only) ---
# Port for the Express dev server. Default 8787. Vite dev-proxies /api here, so
# change both together if you move it. Ignored on Vercel, which assigns its own.
# PORT=8787

# --- Media metadata (all optional; no API keys needed) ---
# The culture search dropdown queries free public databases via the server
# (see server/sources.ts): AniList for anime/manga, Stremio Cinemeta for
# movies, TVmaze for series, the Steam store for games, and Open Library for
# books. None of them require a key or an account, so there is nothing to
# configure here -- these knobs only exist for tuning.
#
# How long to cache a lookup before re-asking upstream, in ms. Default 600000
# (10 min). These are volunteer-run services, so don't set this too low.
# MEDIA_CACHE_TTL_MS=600000

# How many of a user's logged titles to look up when building the context for
# culture AI recommendations. Each one is an upstream request. Default 5.
# CULTURE_FACT_LIMIT=5

# --- Python backend (project-nova/) ---
# Only needed if you also run the FastAPI app in project-nova/.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# SECRET_KEY=
