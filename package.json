{
  "name": "project-nova-p3r",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,ai -c cyan,magenta \"npm:dev:web\" \"npm:dev:ai\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:ai": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "test": "tsx scripts/test-parse.ts && tsx scripts/test-vercel-adapters.ts && tsx scripts/test-profile.ts && tsx scripts/test-render.ts",
    "test:parse": "tsx scripts/test-parse.ts",
    "test:vercel": "tsx scripts/test-vercel-adapters.ts",
    "test:profile": "tsx scripts/test-profile.ts",
    "test:render": "tsx scripts/test-render.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "mock:ai": "tsx scripts/mock-gemini.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@radix-ui/react-slot": "^1.3.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vercel": "^60.1.3",
    "vite": "^6.2.0"
  }
}
